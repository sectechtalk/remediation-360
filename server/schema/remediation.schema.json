{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Intune remediation settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["displayName", "description", "publisher", "runAs", "runAs32Bit", "schedule", "assignment"],
  "properties": {
    "displayName": { "type": "string", "minLength": 3, "maxLength": 100 },
    "description": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "runAs": { "enum": ["system", "user"] },
    "runAs32Bit": { "type": "boolean" },
    "enforceSignatureCheck": { "type": "boolean" },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "interval"],
      "properties": {
        "type": { "enum": ["hourly", "daily", "once"] },
        "interval": { "type": "integer", "minimum": 1, "maximum": 23 },
        "time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$" },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "useUtc": { "type": "boolean" }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [{ "required": ["groupId"] }, { "required": ["groupIds"] }, { "required": ["target"] }],
      "properties": {
        "groupId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$" },
        "groupIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$",
            "not": { "const": "00000000-0000-0000-0000-000000000000" }
          }
        },
        "target": { "enum": ["allDevices"] },
        "runRemediationScript": { "type": "boolean" }
      }
    }
  }
}
